{
  "name": "finledge-desktop",
  "private": true,
  "version": "1.3.0",
  "author": "Sachin Adhikari",
  "productName": "FinLedge",
  "description": "FinLedge personal finance tracker",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sachinadk2011/FinLedge-App.git"
  },
  "scripts": {
    "start": "electron .",
    "prebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-appx-assets.ps1",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.11.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.finledge.tracker",
    "productName": "FinLedge",
    "compression": "maximum",
    "copyright": "Copyright © 2026 Sachin Adhikari",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sachinadk2011",
        "repo": "FinLedge-App",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "ipc/**",
      "services/**",
      "utils/**",
      "assets/**",
      "!assets/appx/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/sidecar/finledge-engine.exe",
        "to": "engine/finledge-engine.exe"
      },
      {
        "from": "../frontendwebapp/dist",
        "to": "frontendwebapp/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/finledge_icon.ico",
      "artifactName": "Finledge-Setup-${version}.${ext}"
    },
    "extends": "./appx-package-config.json",
    "afterPack": "scripts/mark-build-channel.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
