{
  "name": "financial-tracker-root",
  "private": true,
  "version": "1.2.0",
  "author": "Sachin Adhikari",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c green,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node ./scripts/finledge.mjs backend-dev",
    "dev:backend:reload": "node ./scripts/finledge.mjs backend-reload",
    "dev:frontend": "npm run dev --prefix frontendwebapp",
    "build:frontend": "npm run build --prefix frontendwebapp",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\desktop\\scripts\\build-sidecar.ps1",
    "build:desktop": "npm run build --prefix desktop",
    "desktop-dev": "node ./scripts/finledge.mjs desktop-dev",
    "desktop-build": "node ./scripts/finledge.mjs desktop-build",
    "mobile": "node ./scripts/finledge.mjs mobile-android",
    "mobile:build": "node ./scripts/finledge.mjs mobile-build",
    "mobile:test": "node ./scripts/finledge.mjs mobile-test",
    "mobile:sync:android": "node ./scripts/finledge.mjs mobile-sync-android",
    "mobile:android": "node ./scripts/finledge.mjs mobile-android",
    "mobile:run:android": "node ./scripts/finledge.mjs mobile-android-run",
    "simulate-update": "cross-env ELECTRON_DEV=1 FINLEDGE_SIMULATE_UPDATE=1 node ./scripts/finledge.mjs desktop-dev",
    "migrate:preview": "node ./scripts/finledge.mjs migrate-preview",
    "migrate:apply": "node ./scripts/finledge.mjs migrate-apply",
    "release": "node ./scripts/start-release.mjs",
    "version:sync": "node ./scripts/sync-version.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0"
  }
}
