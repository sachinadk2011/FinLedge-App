# All settings are optional. Blank values use FinLedge's built-in defaults.
# Copy this file to .env for source/development use. Never put credentials here.

# Leave blank to infer the mode; set development, testing, or production only to override.
FINLEDGE_MODE=

# Leave blank or use auto for the managed data folder; otherwise enter a full writable folder path.
FINLEDGE_DATA_DIR=

# Leave blank to use desktop/package.json. For a fork, enter your GitHub account/organization.
FINLEDGE_GITHUB_OWNER=

# Leave blank to use desktop/package.json. For a fork, enter the repository name.
FINLEDGE_GITHUB_REPO=

# Leave blank to derive the public policy JSON URL from the repository above; otherwise enter an HTTPS URL.
FINLEDGE_UPDATE_POLICY_URL=

# Leave blank to derive the public releases page from the repository above; otherwise enter its HTTPS releases page.
VITE_FINLEDGE_RELEASES_URL=

# Backend listen address; blank uses local loopback (127.0.0.1).
FINLEDGE_BACKEND_HOST=

# Standalone backend port; blank uses its default. Electron uses the channel-specific port below.
FINLEDGE_BACKEND_PORT=

# Backend log level; blank uses the normal info level. Use debug only for troubleshooting.
FINLEDGE_BACKEND_LOG_LEVEL=

# Vite development-server address; blank uses local loopback (127.0.0.1).
FINLEDGE_FRONTEND_HOST=

# Vite development-server port; blank uses the default for the current run mode.
FINLEDGE_FRONTEND_PORT=

# Optional Electron development backend port override; enter an available port number or leave blank.
FINLEDGE_DESKTOP_DEV_BACKEND_PORT=

# Optional Electron development frontend port override; enter an available port number or leave blank.
FINLEDGE_DESKTOP_DEV_FRONTEND_PORT=

# Installed EXE backend port override; blank uses 8001. Set a different available port only if needed.
FINLEDGE_DESKTOP_EXE_BACKEND_PORT=

# Testing EXE backend port override; blank uses 8201. Set a different available port only if needed.
FINLEDGE_TEST_EXE_BACKEND_PORT=

# Testing AppX backend port override; blank uses 8301. Set a different available port only if needed.
FINLEDGE_TEST_APPX_BACKEND_PORT=

# Microsoft Store backend port override; blank uses 8101. Set a different available port only if needed.
FINLEDGE_STORE_BACKEND_PORT=

# Only for running the frontend outside Electron; enter the backend URL or leave blank for automatic discovery.
VITE_API_BASE_URL=

# Optional source/development Python executable path; leave blank for automatic venv/PATH detection.
FINLEDGE_PYTHON_PATH=

# Development-only update notice preview; leave blank to disable or set to 1 to simulate.
FINLEDGE_SIMULATE_UPDATE=

# GitHub release publishing token. Put the real token only in ignored local .env or CI secrets; never commit it.
GH_TOKEN=

# Electron Builder code-signing password for a configured signing certificate. Keep the real password private.
CSC_KEY_PASSWORD=

# Path to your .pfx certificate for a signed AppX test build; set your own path in local .env only.
FINLEDGE_TEST_CERT_PATH=

# Optional password for the test certificate; the build script passes it to Windows signing.
FINLEDGE_TEST_CERT_PASSWORD=
